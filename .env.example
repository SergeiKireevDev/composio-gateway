HOST=127.0.0.1
PORT=8788
DATA_DIR=./data
# Set to the externally reachable origin when Oyster is on another machine.
PUBLIC_URL=https://gateway.example.com
SESSION_TTL_SECONDS=3600
# Required on a fresh install. Generate at least 32 random bytes and keep
# the original token in a password manager. Only a SHA-256 verifier is
# persisted in DATA_DIR/admin.token.sha256. Empty values fail startup.
# Example generation command: openssl rand -hex 32
ADMIN_TOKEN=
