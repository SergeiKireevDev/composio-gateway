FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY server.mjs store.mjs composio.mjs ./
COPY public ./public
COPY scripts/fly-entrypoint.sh /usr/local/bin/fly-entrypoint
RUN chmod 755 /usr/local/bin/fly-entrypoint
ENV HOST=0.0.0.0 PORT=8788 DATA_DIR=/data
EXPOSE 8788
# Fly volumes initially belong to root. The entrypoint fixes the mount's
# ownership, then drops privileges before starting the application.
ENTRYPOINT ["/usr/local/bin/fly-entrypoint"]
CMD ["node", "server.mjs"]
